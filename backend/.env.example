# GehnaStudio AI Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS - Allow PWA, Android Capacitor (capacitor://localhost, http://localhost), and local dev
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","capacitor://localhost","http://localhost"]

# Database (SQLite default for zero-config local run, or postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=sqlite:///./gehna.db

# Storage Path
STORAGE_DIR=./storage

# OpenAI API Key (Kept strictly on backend - NEVER sent to frontend)
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_IMAGE_MODEL=gpt-image-1
